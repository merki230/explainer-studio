{
  "name": "explainer-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "remotion studio",
    "new": "node scripts/new-video.mjs",
    "timings": "node scripts/fake-timings.mjs",
    "voiceover": "node scripts/voiceover.mjs",
    "voice:room": "node scripts/voice-room.mjs",
    "voiceover:use": "node scripts/use-take.mjs",
    "music": "tsx scripts/music.ts",
    "music:use": "node scripts/music-use.mjs",
    "sfx": "node scripts/sfx.mjs",
    "sfx:click": "node scripts/sfx-click.mjs",
    "sfx:rumble": "node scripts/sfx-rumble.mjs",
    "sfx:whine": "node scripts/sfx-whine.mjs",
    "sfx:charge": "node scripts/sfx-charge.mjs",
    "transcribe": "node scripts/transcribe.mjs",
    "voices": "node scripts/voices.mjs",
    "from-whisper": "node scripts/whisper-to-transcript.mjs",
    "check": "tsx scripts/check.ts",
    "stills": "tsx scripts/stills.ts",
    "render": "node scripts/render.mjs",
    "cover": "node scripts/cover.mjs",
    "package": "node scripts/package.mjs",
    "normalize": "node scripts/normalize.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "yarn typecheck && yarn lint && yarn check"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/google-fonts": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@remotion/three": "4.0.535",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.535",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.535",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/three": "0.169.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "yarn@4.15.0"
}
